@startuml AvitoKitchenUserCJM
title Авито.Кухня - CJM пользователя

start
:Открыть web-страницу Авито.Кухни;
:Получить список заведений;
if (Заведение открыто?) then (да)
  :Открыть меню;
  :Проверить цены, модификаторы и доступность;
  if (Позиция доступна?) then (да)
    :Добавить позиции в заказ;
    :Отправить заказ с Idempotency-Key;
    :Увидеть ожидание решения заведения;
    if (Заведение принимает заказ?) then (да)
      :Увидеть статус accepted;
    else (нет)
      :Увидеть статус rejected;
      :Выбрать другое заведение или блюдо;
    endif
  else (нет)
    :Выбрать другую позицию;
  endif
else (нет)
  :Выбрать другое заведение;
endif
stop

@enduml
